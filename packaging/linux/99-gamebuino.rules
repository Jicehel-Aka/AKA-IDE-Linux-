# Règles udev pour console Gamebuino AKA (ESP32-S3) sous Linux
# Copier dans /etc/udev/rules.d/99-gamebuino.rules puis :
# sudo udevadm control --reload-rules && sudo udevadm trigger

# Gamebuino AKA (Espressif ESP32-S3 USB CDC / JTAG & DFU)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", MODE="0666", GROUP="dialout"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="0002", MODE="0666", GROUP="dialout"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="303a", MODE="0666", GROUP="dialout"

# Périphériques série USB pour téléversement (ESP32-S3 CDC / CP210x / CH340)
KERNEL=="ttyACM*", MODE="0666", GROUP="dialout"
KERNEL=="ttyUSB*", MODE="0666", GROUP="dialout"
