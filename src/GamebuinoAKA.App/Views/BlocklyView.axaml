<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GamebuinoAKA.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="GamebuinoAKA.App.Views.BlocklyView"
             x:DataType="vm:BlocklyViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Bandeau d'en-tête -->
        <Border Grid.Row="0" Background="#1e293b" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🧱" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Studio Visuel Blockly &amp; Simulateur Gamebuino AKA" FontWeight="Bold" FontSize="14" Foreground="#f8fafc" />
                        <TextBlock Text="9 tutoriels guidés multilingues, export MicroPython 60 FPS &amp; C++ natif" FontSize="11" Foreground="#94a3b8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding OpenBlocklyStudioWebCommand}"
                            Background="#10b981" Foreground="#022c22" FontWeight="SemiBold"
                            Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="Ouvrir le Studio Visuel Complet" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SendToScriptEditorCommand}"
                            Background="#3b82f6" Foreground="#ffffff" FontWeight="SemiBold"
                            Padding="12,6" CornerRadius="6">
                        <TextBlock Text="Basculer vers l'Éditeur Python" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Row="1" ColumnDefinitions="320, *" Margin="16">
            <!-- Liste des 9 Tutoriels -->
            <Border Grid.Column="0" Background="#0f172a" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12" Margin="0,0,12,0">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Catalogue des 9 Tutoriels (6 langues)" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" Margin="0,0,0,6" />
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🏓 1. Pong Rétro Complet (5 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🚀 2. Shoot'em Up Spatial (6 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🏃 3. Plateforme avec Gravité (5 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🟡 4. Pac-Maze Labyrinthe (5 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🧮 5. Calculatrice Rétro D-Pad (4 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🐾 6. Animal Virtuel Tamagotchi (4 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="🎹 7. Synthétiseur Chiptune (4 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="⏱️ 8. Chrono Pomodoro (4 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="8">
                            <TextBlock Text="⏳ 9. Minuteur Œufs &amp; Jeux (4 étapes)" FontSize="11" Foreground="#f8fafc" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Aperçu du Code MicroPython & Actions -->
            <Border Grid.Column="1" Background="#0f172a" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="Gabarit MicroPython prêt à injecter :" FontWeight="Bold" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Text="{Binding GeneratedPythonCode}" FontFamily="Consolas, monospace" FontSize="11"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False" Background="#020617" Foreground="#a7f3d0" />
                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748b" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
