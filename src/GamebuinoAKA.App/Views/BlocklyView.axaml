<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GamebuinoAKA.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="GamebuinoAKA.App.Views.BlocklyView"
             x:DataType="vm:BlocklyViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Bandeau d'en-tête -->
        <Border Grid.Row="0" Background="#1e293b" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🧱" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Studio Blockly Gamebuino AKA" FontWeight="Bold" FontSize="14" Foreground="#f8fafc" />
                        <TextBlock Text="Programmation par blocs → code MicroPython (API aka) prêt pour le simulateur et la carte" FontSize="11" Foreground="#94a3b8" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding OpenBlocklyStudioWebCommand}"
                            Background="#10b981" Foreground="#022c22" FontWeight="SemiBold"
                            Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="Ouvrir le Studio Blockly" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnPasteFromStudio"
                            Background="#334155" Foreground="#f8fafc" FontWeight="SemiBold"
                            Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📋" />
                            <TextBlock Text="Coller le code du Studio" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SendToScriptEditorCommand}"
                            Background="#3b82f6" Foreground="#ffffff" FontWeight="SemiBold"
                            Padding="12,6" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="➡" />
                            <TextBlock Text="Envoyer vers l'éditeur" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Row="1" ColumnDefinitions="340, *" Margin="16">
            <!-- Comment ça marche -->
            <Border Grid.Column="0" Background="#0f172a" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Comment ça marche" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" />
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#e2e8f0" Text="1.  Clique « Ouvrir le Studio Blockly » : il s'ouvre dans ton navigateur." />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#e2e8f0" Text="2.  Assemble tes blocs, ou suis le tutoriel guidé « Pong » (6 étapes contrôlées, avec « Injecter dans Blockly »)." />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#e2e8f0" Text="3.  Coche « MicroPython » dans le studio, puis clique « Copier le code »." />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#e2e8f0" Text="4.  Reviens ici et clique « Coller le code du Studio » : il apparaît à droite." />
                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#e2e8f0" Text="5.  Clique « Envoyer vers l'éditeur » : le code s'ouvre dans l'éditeur de scripts, prêt pour « Tester (PC) » ou l'envoi sur la carte." />
                        </StackPanel>
                        <Border Background="#1e293b" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="💡 Bon à savoir" FontWeight="SemiBold" FontSize="11.5" Foreground="#fcd34d" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cbd5e1"
                                           Text="Le studio génère la vraie API de la console en 3 langages — MicroPython (aka), Love2D (Lua) et C++ natif — affichables en parallèle via les cases à cocher. L'onglet « Doc » du studio liste tous les blocs et le code qu'ils produisent." />
                            </StackPanel>
                        </Border>
                        <Border Background="#1e293b" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="✍ Édition directe" FontWeight="SemiBold" FontSize="11.5" Foreground="#93c5fd" />
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#cbd5e1"
                                           Text="La zone de droite est modifiable : tu peux coller ou retoucher le code avant de l'envoyer vers l'éditeur." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Code MicroPython à envoyer -->
            <Border Grid.Column="1" Background="#0f172a" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="Code MicroPython (collé depuis le Studio, modifiable) :" FontWeight="Bold" FontSize="12" Foreground="#94a3b8" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Text="{Binding GeneratedPythonCode}" FontFamily="Consolas, monospace" FontSize="11"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="False" Background="#020617" Foreground="#a7f3d0" />
                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="11" Foreground="#64748b" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
