<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="GamebuinoAKA.App.Views.ScriptEditorView"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Éditeur de script" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="📂 Ouvrir" Command="{Binding OpenCommand}"/>
            <Button Content="💾 Enregistrer" Command="{Binding SaveCommand}"/>
            <Border Width="1" Background="#333" Margin="4,0"/>
            <Button Content="▶ Tester (PC)" Command="{Binding RunOnPcCommand}"/>
            <Button Content="⬆ Envoyer à l'AKA" Command="{Binding SendToDeviceCommand}"/>
            <TextBlock Text="{Binding KindLabel}" Foreground="#8A63D2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ProgressBar IsIndeterminate="True" Width="70" IsVisible="{Binding IsBusy}"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
            <ae:TextEditor x:Name="Editor"
                           ShowLineNumbers="True"
                           FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                           FontSize="13"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#AAA"/>

            <!-- Erreurs cliquables : saut à la ligne fautive -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                        IsVisible="{Binding HasErrors}">
                <TextBlock Text="⚠ Erreurs :" Foreground="#E06C75" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="2" Padding="6,2"
                                    Content="{Binding Raw}"
                                    Command="{Binding $parent[UserControl].DataContext.GoToErrorCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#333" BorderThickness="1" CornerRadius="4" Height="120" Margin="0,6,0,0">
                <ScrollViewer>
                    <TextBox Text="{Binding OutputLog}" IsReadOnly="True" AcceptsReturn="True"
                             Background="Transparent" BorderThickness="0" FontFamily="monospace" FontSize="12"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
