<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GamebuinoAKA.App — UI Avalonia + implémentations de plateforme (Linux/Windows).
    Multiplateforme : net10.0 (PAS net10.0-windows).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>          <!-- app graphique ; ignoré sous Linux -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>GamebuinoAKA.App</RootNamespace>
    <AssemblyName>GamebuinoAKA.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 11.x. Bumpe vers la dernière 11.x si besoin (dotnet add package). -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3"
                      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GamebuinoAKA.Core\GamebuinoAKA.Core.csproj" />
  </ItemGroup>

</Project>
