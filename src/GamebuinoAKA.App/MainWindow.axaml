<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GamebuinoAKA.App.MainWindow"
        Title="Gamebuino AKA IDE"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#1A1A2E" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Gamebuino" FontSize="18" FontWeight="Bold" Foreground="#8A63D2"/>
                <TextBlock Text="AKA IDE — Avalonia" FontSize="14" Foreground="#AAAAAA"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Foreground="#CCCCCC"
                   Text="Squelette Avalonia opérationnel.&#x0a;Les vues et éditeurs seront migrés par lots (voir plan)."/>
    </Grid>
</Window>
